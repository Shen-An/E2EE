		INSERT INTO chat_message_illegal(message_type,message_content,send_user_id,send_time,contact_id,contact_type)values
		<foreach collection="list" item="item" separator=",">
			(#{item.messageType},#{item.messageContent},#{item.sendUserId},#{item.sendTime},#{item.contactId},#{item.contactType})
		</foreach>
