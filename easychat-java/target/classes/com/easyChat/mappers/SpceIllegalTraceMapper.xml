		INSERT INTO spce_illegal_trace(user_id,user_pk,illegal_count,illegal_time)values
		<foreach collection="list" item="item" separator=",">
			(#{item.userId},#{item.userPk},#{item.illegalCount},#{item.illegalTime})
		</foreach>
	</insert>

	<!-- 批量插入或更新 (批量插入)-->
	<insert id="insertOrUpdateBatch" parameterType="com.easyChat.entity.po.SpceIllegalTrace">
		INSERT INTO spce_illegal_trace(user_id,user_pk,illegal_count,illegal_time)values
		<foreach collection="list" item="item" separator="," >
			(#{item.userId},#{item.userPk},#{item.illegalCount},#{item.illegalTime})
		</foreach>
		on DUPLICATE KEY update user_id =VALUES(user_id),user_pk =VALUES(user_pk),illegal_count =VALUES(illegal_count),illegal_time =VALUES(illegal_time)
	</insert>

	<!-- 根据UserId查询-->
	<select id="selectByUserId" resultMap="base_result_map">
		select <include refid="base_column_list"/> from spce_illegal_trace where user_id=#{userId}
	</select>

	<!-- 根据UserId更新-->
	<update id="updateByUserId" parameterType="com.easyChat.entity.po.SpceIllegalTrace">
		update spce_illegal_trace
		<set>
			<if test="bean.userId!=null">
