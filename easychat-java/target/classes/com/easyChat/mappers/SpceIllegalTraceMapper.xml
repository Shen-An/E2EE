<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
		"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.easyChat.mappers.SpceIllegalTraceMapper">
	<!--实体映射-->
	<resultMap id="base_result_map" type="com.easyChat.entity.po.SpceIllegalTrace">
		<!-- 用户id-->
		<id column="user_id" property="userId"/>
		<!-- 用户公钥-->
		<result column="user_pk" property="userPk"/>
		<!-- 非法次数-->
		<result column="illegal_count" property="illegalCount"/>
		<!-- 违规时间-->
		<result column="illegal_time" property="illegalTime"/>
	</resultMap>

	<!--通用查询列-->
	<sql id="base_column_list">
		user_id,user_pk,illegal_count,illegal_time
	</sql>

	<!--基础查询条件-->
	<sql id="base_query_condition">
		<if test="query.userId != null and query.userId != ''">
			and user_id = #{query.userId}
		</if>
		<if test="query.userPk != null and query.userPk != ''">
			and user_pk = #{query.userPk}
		</if>
		<if test="query.illegalCount != null">
			and illegal_count = #{query.illegalCount}
		</if>
		<if test="query.illegalTime != null">
			and illegal_time = #{query.illegalTime}
		</if>
	</sql>

	<!--扩展的查询条件-->
	<sql id="base_query_condition_extend">
		<if test="query.userIdFuzzy != null and query.userIdFuzzy !=''">
			and user_id like concat('%', #{query.userIdFuzzy}, '%')
		</if>
		<if test="query.userPkFuzzy != null and query.userPkFuzzy !=''">
			and user_pk like concat('%', #{query.userPkFuzzy}, '%')
		</if>
	</sql>

	<!--扩展的查询条件-->
	<sql id="query_condition">
		<where>
			<include refid = "base_query_condition"/>
			<include refid = "base_query_condition_extend"/>
		</where>
	</sql>

	<!--查询列表-->
	<select id="selectList" resultMap="base_result_map">
		SELECT <include refid = "base_column_list"/> FROM spce_illegal_trace <include refid="query_condition"/>
		<if test="query.orderBy!=null"> order by ${query.orderBy} </if>
		<if test="query.simplePage!=null">limit #{query.simplePage.start},#{query.simplePage.end} </if>
	</select>
	<!--查询数量-->
	<select id="selectCount" resultType="java.lang.Integer">
		SELECT count(1) FROM spce_illegal_trace <include refid="query_condition"/>
	</select>

	<!--插入 (匹配有值都字段)-->
	<insert id="insert" parameterType="com.easyChat.entity.po.SpceIllegalTrace">

		INSERT INTO spce_illegal_trace
		<trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="bean.userId != null">
				user_id,
			</if>
			<if test="bean.userPk != null">
				user_pk,
			</if>
			<if test="bean.illegalCount != null">
				illegal_count,
			</if>
			<if test="bean.illegalTime != null">
				illegal_time,
			</if>
		</trim>
		<trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="bean.userId != null">
				#{bean.userId},
			</if>
			<if test="bean.userPk != null">
				#{bean.userPk},
			</if>
			<if test="bean.illegalCount != null">
				#{bean.illegalCount},
			</if>
			<if test="bean.illegalTime != null">
				#{bean.illegalTime},
			</if>
		</trim>
	</insert>

	<!--插入或者更新 (匹配有值都字段)-->
	<insert id="insertOrUpdate" parameterType="com.easyChat.entity.po.SpceIllegalTrace">
		INSERT INTO spce_illegal_trace
		<trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="bean.userId != null">
				user_id,
			</if>
			<if test="bean.userPk != null">
				user_pk,
			</if>
			<if test="bean.illegalCount != null">
				illegal_count,
			</if>
			<if test="bean.illegalTime != null">
				illegal_time,
			</if>
		</trim>
		<trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="bean.userId != null">
				#{bean.userId},
			</if>
			<if test="bean.userPk != null">
				#{bean.userPk},
			</if>
			<if test="bean.illegalCount != null">
				#{bean.illegalCount},
			</if>
			<if test="bean.illegalTime != null">
				#{bean.illegalTime},
			</if>
		</trim>
		on DUPLICATE key update
		<trim prefix="" suffix="" suffixOverrides=",">
			<if test="bean.userPk != null">
				user_pk =VALUES(user_pk),
			</if>
			<if test="bean.illegalCount != null">
