		</foreach>
		on DUPLICATE KEY update id =VALUES(id),email =VALUES(email),user_id =VALUES(user_id),status =VALUES(status)
	</insert>

	<!-- 根据Id查询-->
	<select id="selectById" resultMap="base_result_map">
